{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@engine/*": [
        "_engine/*"
      ],
      "@game/*": [
        "_game/*"
      ]
    }
  },
  "include": [
    "_engine/**/*.ts",
    "_game/**/*.ts",
    "*/src/**/*.ts"
  ]
}
